{
  "name": "aether-engine",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, beginner-friendly 2D game engine",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "npm --workspace=@aether/editor run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
